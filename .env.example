# Local service and seeded checkout
TARGET_REPO_PATH=../acmepay-invoice-service
TARGET_API_URL=http://localhost:8001
TARGET_BASE_BRANCH=main
TARGET_PR_BRANCH=feat/security-tightening-pr402
PREFLIGHT_API_URL=http://localhost:8000
PREFLIGHT_LEDGER_PATH=data/audit_ledger.json
PREFLIGHT_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ACMEPAY_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
PORT=8000

# Local operator and optional API authentication. Supply your own secrets.
PREFLIGHT_LOCAL_OPERATOR=authenticated-local-operator
PREFLIGHT_APPROVAL_TOKEN=
PREFLIGHT_APPROVAL_ID=
PREFLIGHT_API_TOKEN=
PREFLIGHT_SWITCH_WEBHOOK_TOKEN=
PREFLIGHT_SWITCH_APPROVER=

# Switch Console telemetry and optional legacy relay
PREFLIGHT_SWITCH_CONSOLE=0
PREFLIGHT_SWITCH_SERVER_URL=
SWITCH_SERVER_URL=
SWITCH_BASE_URL=
SWITCH_AGENT_ID=
SWITCH_ROOM_ID=
SWITCH_AGENT_TOKEN=
SWITCH_AGENT_API_KEY=
# SWITCH_API_ENDPOINT and SWITCH_API_TOKEN are provisioned by Switch Console.
# APPDATA is supplied by Windows. The pinned listener reads managed bindings there.

# Optional publication and advisory integrations
PREFLIGHT_GH_PATH=
GH_TOKEN=
GITHUB_TOKEN=
DISCORD_WEBHOOK_URL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Shell launcher and Compose settings. Export shell settings before invoking make.
# PYTHON=python3
ACMEPAY_REPO_PATH=../acmepay-invoice-service
PREFLIGHT_CONTAINER_UID=10001
PREFLIGHT_CONTAINER_GID=10001
